      "name": "Reconcile by paymentId",
      "item": [
        {
          "name": "Get reconciled payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reconciliations/payments/PAY-1001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reconciliations",
                "payments",
                "PAY-1001"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('paymentId is PAY-1001', function () { pm.expect(json.paymentId).to.eql('PAY-1001'); });",
                  "pm.test('reconciliationStatus is RECONCILED', function () { pm.expect(json.reconciliationStatus).to.eql('RECONCILED'); });",
                  "pm.test('reconciled is true', function () { pm.expect(json.reconciled).to.eql(true); });"
                ]
              }
            }
          ]
        },
